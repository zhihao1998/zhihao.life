---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { projects } from '../../data/projects';
import { newsBySlug } from '../../data/news';
---

<BaseLayout
  title="Projects"
  description="Open research projects by Zhihao Wang — NIKA and ChamaleoNet."
>
  <div class="page-pad py-14 sm:py-20">
    <header class="mb-12">
      <h1 class="type-display text-4xl text-ink sm:text-5xl">Projects</h1>
    </header>

    <div class="space-y-16">
      {
        projects.map((project) => {
          const updates = newsBySlug(project.news);
          return (
            <section class="border-t border-line pt-10">
              <div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.15fr)] lg:items-start">
                <div class="min-w-0">
                  {project.teaser && (
                    <a href={`/projects/${project.slug}/`} class="project-teaser mb-5 block">
                      <img
                        src={project.teaser}
                        alt=""
                        width="720"
                        height="360"
                        loading="lazy"
                        decoding="async"
                        class="h-full w-full object-contain"
                      />
                    </a>
                  )}
                  <p class="text-sm text-muted">
                    {project.status}
                    <span aria-hidden="true"> · </span>
                    {project.period}
                  </p>
                  <h2 class="type-display mt-2 text-3xl text-ink">
                    <a class="hover:text-steel" href={`/projects/${project.slug}/`}>
                      {project.name}
                    </a>
                  </h2>
                  <p class="mt-2 text-lg text-ink-soft">{project.tagline}</p>
                  <div class="mt-4 space-y-3 text-[1.02rem] leading-relaxed text-ink-soft">
                    {project.summary.map((p) => (
                      <p>{p}</p>
                    ))}
                  </div>
                  <ul class="mt-5 flex flex-wrap gap-x-4 gap-y-2 text-sm text-steel">
                    {project.links.map((link) => (
                      <li>
                        <a
                          class="underline-offset-2 hover:underline"
                          href={link.href}
                          rel={link.href.startsWith('http') ? 'noopener noreferrer' : undefined}
                          target={link.href.startsWith('http') ? '_blank' : undefined}
                        >
                          {link.label}
                        </a>
                      </li>
                    ))}
                    <li>
                      <a class="underline-offset-2 hover:underline" href={`/projects/${project.slug}/`}>
                        Details
                      </a>
                    </li>
                  </ul>
                </div>

                <div class="min-w-0">
                  <h3 class="type-display text-xl text-ink">Related news</h3>
                  <ul class="mt-4 space-y-5">
                    {updates.map((item) => (
                      <li class="border-t border-line pt-4 first:border-t-0 first:pt-0">
                        <p class="text-sm text-muted">
                          {new Date(item.date).toLocaleDateString('en-US', {
                            year: 'numeric',
                            month: 'short',
                            day: 'numeric',
                          })}
                        </p>
                        <a
                          class="mt-1 block font-medium text-ink hover:text-steel"
                          href={`/news/${item.slug}/`}
                        >
                          {item.title}
                        </a>
                        <p class="mt-1 text-sm text-ink-soft">{item.summary}</p>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
            </section>
          );
        })
      }
    </div>
  </div>
</BaseLayout>

<style>
  .project-teaser {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: #fff;
    border: 1px solid var(--color-line);
  }
</style>
