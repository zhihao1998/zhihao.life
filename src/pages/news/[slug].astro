---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { news, getNews } from '../../data/news';

export function getStaticPaths() {
  return news.map((item) => ({
    params: { slug: item.slug },
  }));
}

const { slug } = Astro.params;
const item = getNews(slug!);
if (!item) {
  return Astro.redirect('/news/');
}
---

<BaseLayout title={item.title} description={item.summary}>
  <article class="page-pad py-14 sm:py-20">
    <header class="mb-10 max-w-2xl">
      <p class="text-sm text-muted">
        <a href="/news/" class="hover:text-ink">News</a>
        <span class="mx-2">/</span>
        {new Date(item.date).toLocaleDateString('en-US', {
          year: 'numeric',
          month: 'long',
          day: 'numeric',
        })}
      </p>
      <h1 class="type-display mt-3 text-4xl text-ink sm:text-5xl">{item.title}</h1>
    </header>

    <div class="prose-academic space-y-4">
      {item.body.map((p) => <p>{p}</p>)}
    </div>

    {
      item.links && item.links.length > 0 && (
        <ul class="mt-10 flex flex-wrap gap-4 text-sm text-steel">
          {item.links.map((link) => (
            <li>
              <a class="hover:underline" href={link.href}>
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </article>
</BaseLayout>
