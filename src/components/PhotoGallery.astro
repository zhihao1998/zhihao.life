---
import { Image, getImage } from 'astro:assets';
import type { AlbumPhoto } from '../data/albums';

interface Props {
  photos: AlbumPhoto[];
}

const { photos } = Astro.props;

/** Lightbox master — sharper than the old 1200@70; deploy-dist chunks >350KB uploads. */
const slides = await Promise.all(
  photos.map(async (photo) => {
    const full = await getImage({
      src: photo.src,
      width: 1800,
      format: 'webp',
      quality: 80,
    });
    return {
      src: full.src,
      width: Number(full.attributes.width),
      height: Number(full.attributes.height),
      alt: photo.alt,
      photo,
    };
  }),
);
---

<div class="pswp-gallery grid grid-cols-2 gap-2 md:grid-cols-3 md:gap-3" id="gallery">
  {
    slides.map((slide, i) => (
      <a
        href={slide.src}
        class="photo-tile aspect-[4/5] cursor-zoom-in"
        data-pswp-width={slide.width}
        data-pswp-height={slide.height}
        data-cropped="true"
        target="_blank"
        rel="noreferrer"
        aria-label={`Open ${slide.alt}`}
      >
        <Image
          src={slide.photo.src}
          alt={slide.alt}
          width={1200}
          widths={[480, 800, 1200]}
          sizes="(max-width: 768px) 50vw, 33vw"
          quality={80}
          format="webp"
          class="h-full w-full object-cover"
          loading={i < 3 ? 'eager' : 'lazy'}
        />
      </a>
    ))
  }
</div>

<script>
  import PhotoSwipeLightbox from 'photoswipe/lightbox';
  import 'photoswipe/style.css';

  function initGallery() {
    const gallery = document.querySelector('#gallery');
    if (!(gallery instanceof HTMLElement)) return;
    if (gallery.dataset.pswpInit === '1') return;
    gallery.dataset.pswpInit = '1';

    const lightbox = new PhotoSwipeLightbox({
      gallery,
      children: 'a',
      pswpModule: () => import('photoswipe'),
      showHideAnimationType: 'fade',
      loop: true,
      wheelToZoom: true,
      arrowKeys: true,
      // Advance on click/tap — zoom stays available via the UI button / pinch / wheel
      imageClickAction: 'next',
      tapAction: 'next',
      padding: { top: 24, bottom: 24, left: 48, right: 48 },
    });
    lightbox.init();
  }

  initGallery();
  document.addEventListener('astro:page-load', initGallery);
</script>

<style>
  .photo-tile {
    overflow: hidden;
    background: color-mix(in srgb, var(--color-line) 55%, transparent);
  }
  .photo-tile img {
    transition: transform 0.45s ease;
  }
  .photo-tile:hover img {
    transform: scale(1.03);
  }

  /*
    PhotoSwipe hides arrows on touch devices until a mouse is detected.
    Force them so left/right navigation is always obvious.
  */
  :global(.pswp--touch .pswp__button--arrow),
  :global(.pswp__button--arrow) {
    visibility: visible !important;
  }
</style>
