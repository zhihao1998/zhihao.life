---
import { getImage } from 'astro:assets';
import type { AlbumPhoto } from '../data/albums';

interface Props {
  photos: AlbumPhoto[];
}

const { photos } = Astro.props;

/** One webp per frame keeps dist small enough for the 2 GiB ECS. */
const slides = await Promise.all(
  photos.map(async (photo) => {
    const full = await getImage({
      src: photo.src,
      width: 1200,
      format: 'webp',
      quality: 70,
    });
    const thumb = await getImage({
      src: photo.src,
      width: 640,
      format: 'webp',
      quality: 68,
    });
    return {
      full: full.src,
      thumb: thumb.src,
      width: Number(full.attributes.width),
      height: Number(full.attributes.height),
      alt: photo.alt,
    };
  }),
);
---

<div class="pswp-gallery grid grid-cols-2 gap-2 md:grid-cols-3 md:gap-3" id="gallery">
  {
    slides.map((slide, i) => (
      <a
        href={slide.full}
        class="photo-tile aspect-[4/5] cursor-zoom-in"
        data-pswp-width={slide.width}
        data-pswp-height={slide.height}
        data-cropped="true"
        target="_blank"
        rel="noreferrer"
        aria-label={`Open ${slide.alt}`}
      >
        <img
          src={slide.thumb}
          alt={slide.alt}
          width={640}
          height={Math.round((640 * slide.height) / slide.width)}
          class="h-full w-full object-cover"
          loading={i < 3 ? 'eager' : 'lazy'}
          decoding="async"
        />
      </a>
    ))
  }
</div>

<script>
  import PhotoSwipeLightbox from 'photoswipe/lightbox';
  import 'photoswipe/style.css';

  const gallery = document.querySelector('#gallery');
  if (gallery instanceof HTMLElement) {
    const lightbox = new PhotoSwipeLightbox({
      gallery,
      children: 'a',
      pswpModule: () => import('photoswipe'),
      showHideAnimationType: 'fade',
      loop: true,
      wheelToZoom: true,
      arrowKeys: true,
      imageClickAction: 'zoom',
      tapAction: 'toggle-controls',
      padding: { top: 24, bottom: 24, left: 16, right: 16 },
    });
    lightbox.init();
  }
</script>

<style>
  .photo-tile {
    overflow: hidden;
    background: color-mix(in srgb, var(--color-line) 55%, transparent);
  }
  .photo-tile img {
    transition: transform 0.45s ease;
  }
  .photo-tile:hover img {
    transform: scale(1.03);
  }
</style>
