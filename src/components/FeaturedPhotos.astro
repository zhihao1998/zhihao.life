---
import { Image } from 'astro:assets';
import { featuredPhotoPool } from '../data/albums';

const SLOT_COUNT = 8;
/** Build-time pool; client shuffles a fresh 8 into the mosaic on each visit. */
const pool = featuredPhotoPool(24);
---

<section class="page-pad py-16 sm:py-20">
  <div class="mb-8 flex items-end justify-between gap-4">
    <h2 class="type-display text-2xl text-ink sm:text-3xl">Selected photographs</h2>
    <a href="/portfolio/" class="hidden text-sm text-steel hover:underline sm:inline">
      All albums
    </a>
  </div>

  <div class="photo-mosaic" data-featured-mosaic>
    {
      pool.map(({ photo, album }, i) => (
        <a
          href={`/portfolio/${album.slug}/`}
          class:list={['photo-tile', i < SLOT_COUNT && `tile-${i}`]}
          data-featured-item
          hidden={i >= SLOT_COUNT}
        >
          <Image
            src={photo.src}
            alt={`${photo.alt} — ${album.title}`}
            widths={[640]}
            sizes={
              i === 0 || i === 1
                ? '(max-width: 768px) 100vw, 50vw'
                : '(max-width: 768px) 50vw, 33vw'
            }
            class="h-full w-full object-cover"
            loading={i < 3 ? 'eager' : 'lazy'}
          />
        </a>
      ))
    }
  </div>

  <a href="/portfolio/" class="mt-6 inline-block text-sm text-steel hover:underline sm:hidden">
    All albums
  </a>
</section>

<script>
  const SLOT_COUNT = 8;

  function shuffle<T>(items: T[]) {
    for (let i = items.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [items[i], items[j]] = [items[j]!, items[i]!];
    }
    return items;
  }

  function refreshFeaturedMosaic() {
    const root = document.querySelector<HTMLElement>('[data-featured-mosaic]');
    if (!root) return;
    const items = [...root.querySelectorAll<HTMLElement>('[data-featured-item]')];
    if (items.length === 0) return;

    shuffle(items);
    items.forEach((el, i) => {
      el.className = 'photo-tile';
      if (i < SLOT_COUNT) {
        el.classList.add(`tile-${i}`);
        el.hidden = false;
        const img = el.querySelector('img');
        if (img) img.loading = i < 3 ? 'eager' : 'lazy';
      } else {
        el.hidden = true;
      }
      root.appendChild(el);
    });
    root.dataset.ready = '1';
  }

  refreshFeaturedMosaic();
  document.addEventListener('astro:page-load', refreshFeaturedMosaic);
</script>

<style>
  /*
    Explicit mosaic: every cell claimed — irregular spans, no holes.

    Desktop 6×4:
      [ 0 0 0 | 1 1 1 ]
      [ 0 0 0 | 2 | 3 3 ]
      [ 4 4 | 5 5 | 6 6 ]
      [ 4 4 | 7 7 | 6 6 ]

    Mobile 2×5:
      [ 0 0 ] / [ 1 | 2 ] / [ 3 | 4 ] / [ 3 | 5 ] / [ 6 | 7 ]
  */
  .photo-mosaic {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-template-rows: repeat(5, clamp(8rem, 24vw, 11rem));
    gap: 0.5rem;
  }

  .photo-mosaic:not([data-ready]) {
    visibility: hidden;
  }

  @media (scripting: none) {
    .photo-mosaic:not([data-ready]) {
      visibility: visible;
    }
  }

  .photo-tile {
    display: block;
    min-width: 0;
    min-height: 0;
    overflow: hidden;
  }

  .photo-tile[hidden] {
    display: none !important;
  }

  /* Mobile: 2×5 = 10 cells, all claimed
     [0 0] / [1 2] / [3 4] / [3 5] / [6 7] */
  .tile-0 {
    grid-column: 1 / -1;
    grid-row: 1 / 2;
  }
  .tile-1 {
    grid-column: 1;
    grid-row: 2 / 3;
  }
  .tile-2 {
    grid-column: 2;
    grid-row: 2 / 3;
  }
  .tile-3 {
    grid-column: 1;
    grid-row: 3 / 5;
  }
  .tile-4 {
    grid-column: 2;
    grid-row: 3 / 4;
  }
  .tile-5 {
    grid-column: 2;
    grid-row: 4 / 5;
  }
  .tile-6 {
    grid-column: 1;
    grid-row: 5 / 6;
  }
  .tile-7 {
    grid-column: 2;
    grid-row: 5 / 6;
  }

  @media (min-width: 768px) {
    .photo-mosaic {
      grid-template-columns: repeat(6, minmax(0, 1fr));
      grid-template-rows: repeat(4, clamp(9rem, 14vw, 13rem));
      gap: 0.75rem;
    }

    .tile-0 {
      grid-column: 1 / 4;
      grid-row: 1 / 3;
    }
    .tile-1 {
      grid-column: 4 / 7;
      grid-row: 1 / 2;
    }
    .tile-2 {
      grid-column: 4 / 5;
      grid-row: 2 / 3;
    }
    .tile-3 {
      grid-column: 5 / 7;
      grid-row: 2 / 3;
    }
    .tile-4 {
      grid-column: 1 / 3;
      grid-row: 3 / 5;
    }
    .tile-5 {
      grid-column: 3 / 5;
      grid-row: 3 / 4;
    }
    .tile-6 {
      grid-column: 5 / 7;
      grid-row: 3 / 5;
    }
    .tile-7 {
      grid-column: 3 / 5;
      grid-row: 4 / 5;
    }
  }
</style>
